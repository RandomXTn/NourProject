# =============================================================================
# LUXE STORE — Environment Variables
# Copy this file to .env.local and fill in real values
# =============================================================================

# --- Database ---
# Development: SQLite (file:./dev.db)
# Production: PostgreSQL
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@host:5432/luxe_store"

# --- NextAuth ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"   # openssl rand -base64 32

# --- Image Upload (Cloudinary) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_UPLOAD_PRESET="luxe_store"

# --- Email (Resend) ---
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="noreply@yourdomain.com"
STORE_EMAIL="contact@yourdomain.com"

# --- Cloudflare Turnstile (spam protection) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-site-key"
TURNSTILE_SECRET_KEY="your-secret-key"

# --- Payment Gateway ---
# Konnect (Tunisia)
KONNECT_API_KEY="your-konnect-api-key"
KONNECT_WALLET_ID="your-wallet-id"
NEXT_PUBLIC_KONNECT_API_URL="https://api.preprod.konnect.network/api/v2"

# --- Store ---
NEXT_PUBLIC_STORE_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="NOUR"
